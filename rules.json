  "regexRules": [
    {
      "id": "double_space",
      "pattern": " {2,}",
      "flags": "g",
      "message": "مسافة مزدوجة — يجب استخدام مسافة واحدة",
      "replacement": " "
    },
    {
      "id": "fasla_after_gt",
      "pattern": ">\\s*،",
      "flags": "g",
      "message": "موضع الفاصلة غير صحيح بعد '>'",
      "replacement": ">،"
    },
    {
      "id": "space_after_waw_aleflam",
      "pattern": "(^|[\\s\\u200b])(و|ال)\\s+(?=\\S)",
      "flags": "g",
      "message": "مسافة زائدة بعد 'و' أو 'ال'",
      "replacement": "$1$2"
    },
    {
      "id": "space_before_punctuation",
      "pattern": "\\s+([،؛:.!?])",
      "flags": "g",
      "message": "مسافة غير صحيحة قبل علامة الترقيم",
      "replacement": "$1"
    },
    {
      "id": "no_space_after_arabic_comma",
      "pattern": "،(?!\\s|$)",
      "flags": "g",
      "message": "يجب وضع مسافة بعد الفاصلة العربية",
      "replacement": "، "
    },
    {
      "id": "no_space_after_arabic_semicolon",
      "pattern": "؛(?!\\s|$)",
      "flags": "g",
      "message": "يجب وضع مسافة بعد الفاصلة المنقوطة",
      "replacement": "؛ "
    },
    {
      "id": "tatweel_abuse",
      "pattern": "ـ{3,}",
      "flags": "g",
      "message": "استخدام مفرط للتطويل (ـ)",
      "replacement": "ـ"
    },
    {
      "id": "latin_comma_in_arabic",
      "pattern": "(?<=[\\u0600-\\u06FF\\s]),(?=[\\s\\u0600-\\u06FF])",
      "flags": "g",
      "message": "استخدام الفاصلة اللاتينية في نص عربي — يُفضّل الفاصلة العربية ،",
      "replacement": "،"
    },
    {
      "id": "trailing_whitespace",
      "pattern": "[ \\t]+$",
      "flags": "gm",
      "message": "مسافة بيضاء زائدة في نهاية السطر",
      "replacement": ""
    },
    {
      "id": "leading_space_line",
      "pattern": "^[ \\t]+",
      "flags": "gm",
      "message": "مسافة بيضاء زائدة في بداية السطر",
      "replacement": ""
    },
    {
      "id": "question_mark_arabic",
      "pattern": "\\?(?=[\\u0600-\\u06FF])|(?<=[\\u0600-\\u06FF])\\?",
      "flags": "g",
      "message": "يُفضّل استخدام علامة الاستفهام العربية ؟ بدلاً من ؟",
      "replacement": "؟"
    }
  ]
}
